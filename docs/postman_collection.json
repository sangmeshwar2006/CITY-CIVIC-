{
  "info": {
    "name": "City Civic REST API",
    "_postman_id": "c1f7c100-3490-4820-a430-81f1816f91a2",
    "description": "Complete Postman collection for the City Civic Issue Reporting System REST API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Citizen",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sangmeshwar Yerbage\",\n  \"email\": \"citizen@citycivic.com\",\n  \"password\": \"User@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@citycivic.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Complaints",
      "item": [
        {
          "name": "List All Complaints",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/complaints",
              "host": ["{{baseUrl}}"],
              "path": ["complaints"]
            }
          }
        },
        {
          "name": "Filter Complaints (Status & Category)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/complaints?status=Submitted&category=Roads",
              "host": ["{{baseUrl}}"],
              "path": ["complaints"],
              "query": [
                {
                  "key": "status",
                  "value": "Submitted"
                },
                {
                  "key": "category",
                  "value": "Roads"
                }
              ]
            }
          }
        },
        {
          "name": "Create Complaint",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Damaged Storm Drain",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Storm drain grating is broken near the market square.",
                  "type": "text"
                },
                {
                  "key": "category",
                  "value": "Sewage",
                  "type": "text"
                },
                {
                  "key": "latitude",
                  "value": "17.9104",
                  "type": "text"
                },
                {
                  "key": "longitude",
                  "value": "77.5199",
                  "type": "text"
                },
                {
                  "key": "address",
                  "value": "Market Square, Sector 2",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/complaints",
              "host": ["{{baseUrl}}"],
              "path": ["complaints"]
            }
          }
        },
        {
          "name": "Update Complaint Status (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"In Progress\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/complaints/:id/status",
              "host": ["{{baseUrl}}"],
              "path": ["complaints", ":id", "status"],
              "variable": [
                {
                  "key": "id",
                  "value": "complaint_id_here"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Complaint (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/complaints/:id",
              "host": ["{{baseUrl}}"],
              "path": ["complaints", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "complaint_id_here"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Get Municipal Overview",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/analytics/overview",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "overview"]
            }
          }
        }
      ]
    }
  ]
}
